<?xml version="1.0"?>
<sdf version="1.7">

  <model name="simple_robot">

    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <!-- ================= BASE ================= -->

    <link name="base_link">

      <!-- Base center -->
      <pose>0 0 0.30 0 0 0</pose>

      <inertial>
        <mass>5.0</mass>

        <inertia>
          <ixx>0.20</ixx>
          <iyy>0.30</iyy>
          <izz>0.30</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.8 0.5 0.3</size>
          </box>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.8 0.5 0.3</size>
          </box>

          <material>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </geometry>
      </visual>

    </link>


    <!-- ================= LEFT WHEEL ================= -->

    <link name="left_wheel">

      <!-- Link frame stays UNROTATED (only translated). The 90° roll that
           lays the cylinder on its side is applied to the collision/visual
           geometry only, below. This keeps the joint axis below expressed
           in a frame that is trivially aligned with the model/world frame,
           so "0 1 0" unambiguously means the model's Y axis -- no
           use_parent_model_frame / expressed_in frame trickery needed,
           which is what makes the wheel actually roll instead of spinning
           in place about the wrong axis. -->
      <pose>0 0.32 0.15 0 0 0</pose>

      <inertial>
        <mass>0.5</mass>

        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
        </inertia>
      </inertial>

      <collision name="left_wheel_collision">

        <pose>0 0 0 1.5708 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>

        <surface>

          <friction>
            <ode>
              <mu>10.0</mu>
              <mu2>10.0</mu2>
            </ode>
          </friction>

          <contact>
            <ode>
              <soft_cfm>0.0</soft_cfm>
              <soft_erp>0.2</soft_erp>
            </ode>
          </contact>

        </surface>

      </collision>

      <visual name="left_wheel_visual">

        <pose>0 0 0 1.5708 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>

        <material>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>

      </visual>

    </link>


    <!-- ================= RIGHT WHEEL ================= -->

    <link name="right_wheel">

      <!-- Link frame stays unrotated; see note on left_wheel above. -->
      <pose>0 -0.32 0.15 0 0 0</pose>

      <inertial>
        <mass>0.5</mass>

        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
        </inertia>
      </inertial>

      <collision name="right_wheel_collision">

        <pose>0 0 0 1.5708 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>

        <surface>

          <friction>
            <ode>
              <mu>10.0</mu>
              <mu2>10.0</mu2>
            </ode>
          </friction>

          <contact>
            <ode>
              <soft_cfm>0.0</soft_cfm>
              <soft_erp>0.2</soft_erp>
            </ode>
          </contact>

        </surface>

      </collision>

      <visual name="right_wheel_visual">

        <pose>0 0 0 1.5708 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>

        <material>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>

      </visual>

    </link>


    <!-- ================= LEFT JOINT ================= -->

    <joint name="left_joint" type="revolute">

      <parent>base_link</parent>
      <child>left_wheel</child>

      <axis>

        <!-- Joint frame defaults to the child (left_wheel) link's frame,
             which is now unrotated (see left_wheel's <pose>), so "0 1 0"
             here is unambiguously the model's Y axis -- the wheel rolls
             instead of spinning about the wrong axis. -->
        <xyz>0 1 0</xyz>

        <limit>
          <lower>-1000000</lower>
          <upper>1000000</upper>
          <effort>1000</effort>
          <velocity>100</velocity>
        </limit>

        <dynamics>
          <damping>0.01</damping>
          <friction>0.0</friction>
        </dynamics>

      </axis>

    </joint>


    <!-- ================= RIGHT JOINT ================= -->

    <joint name="right_joint" type="revolute">

      <parent>base_link</parent>
      <child>right_wheel</child>

      <axis>

        <!-- See note on the left joint above. -->
        <xyz>0 1 0</xyz>

        <limit>
          <lower>-1000000</lower>
          <upper>1000000</upper>
          <effort>1000</effort>
          <velocity>100</velocity>
        </limit>

        <dynamics>
          <damping>0.01</damping>
          <friction>0.0</friction>
        </dynamics>

      </axis>

    </joint>


    <!-- ================= CASTER WHEELS (front + rear support) ================= -->
    <!-- Fixed, near-frictionless spheres. The two drive wheels only give
         left/right support; a single caster still leaves the robot free
         to pitch nose-down/up under acceleration and get stuck once it
         tips far enough (confirmed empirically). Front + rear casters
         give a full 4-point stable base. -->

    <link name="caster_wheel_front">

      <pose>0.32 0 0.10 0 0 0</pose>

      <inertial>
        <mass>0.1</mass>

        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>

      <collision name="caster_front_collision">
        <geometry>
          <sphere>
            <radius>0.10</radius>
          </sphere>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>0.01</mu>
              <mu2>0.01</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="caster_front_visual">
        <geometry>
          <sphere>
            <radius>0.10</radius>
          </sphere>
        </geometry>

        <material>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

    </link>


    <link name="caster_wheel_rear">

      <pose>-0.32 0 0.10 0 0 0</pose>

      <inertial>
        <mass>0.1</mass>

        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>

      <collision name="caster_rear_collision">
        <geometry>
          <sphere>
            <radius>0.10</radius>
          </sphere>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>0.01</mu>
              <mu2>0.01</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="caster_rear_visual">
        <geometry>
          <sphere>
            <radius>0.10</radius>
          </sphere>
        </geometry>

        <material>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

    </link>


    <!-- ================= CASTER JOINTS ================= -->

    <joint name="caster_front_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_wheel_front</child>
    </joint>

    <joint name="caster_rear_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_wheel_rear</child>
    </joint>


    <!-- ================= LIDAR ================= -->

    <link name="lidar_link">

      <pose>0.35 0 0.55 0 0 0</pose>

      <inertial>
        <mass>0.1</mass>

        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>

      <sensor name="lidar_sensor" type="gpu_lidar">

        <topic>/lidar</topic>

        <update_rate>10</update_rate>

        <lidar>

          <scan>

            <horizontal>

              <samples>360</samples>
              <resolution>1</resolution>

              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>

            </horizontal>

          </scan>

          <range>

            <min>0.1</min>
            <max>10.0</max>
            <resolution>0.01</resolution>

          </range>

        </lidar>

        <always_on>1</always_on>
        <visualize>true</visualize>

      </sensor>

    </link>


    <!-- ================= LIDAR JOINT ================= -->
    <!-- Without this the lidar_link has no joint at all, making it an
         independent free body that just falls away from the robot. -->

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>


    <!-- ================= DIFFERENTIAL DRIVE ================= -->

    <plugin
      filename="libignition-gazebo-diff-drive-system.so"
      name="ignition::gazebo::systems::DiffDrive">

      <left_joint>left_joint</left_joint>
      <right_joint>right_joint</right_joint>

      <wheel_separation>0.64</wheel_separation>
      <wheel_radius>0.15</wheel_radius>

      <odom_publish_frequency>30</odom_publish_frequency>

      <topic>/cmd_vel</topic>

      <max_linear_acceleration>2.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>

      <max_linear_velocity>2.0</max_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>

    </plugin>

  </model>

</sdf>